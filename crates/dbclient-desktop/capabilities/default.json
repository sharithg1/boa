{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Everything the UI needs: core IPC, events, window dragging, dialogs and the database commands.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "dialog:allow-save",
    "allow-app-info",
    "allow-list-connections",
    "allow-save-connection",
    "allow-delete-connection",
    "allow-test-connection",
    "allow-connect",
    "allow-disconnect",
    "allow-list-schemas",
    "allow-introspect",
    "allow-run-query",
    "allow-cancel-query",
    "allow-history-list",
    "allow-history-append",
    "allow-history-delete",
    "allow-history-clear"
  ]
}
